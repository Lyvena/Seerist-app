{
  "manifest_version": 3,
  "name": "Seerist Capture",
  "version": "1.1.0",
  "description": "Capture jobs you're already browsing on Upwork, Fiverr, Freelancer.com and Toptal into Seerist, and autofill approved proposals. You always click Submit yourself — Seerist never automates platform actions.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://*.upwork.com/*",
    "https://*.fiverr.com/*",
    "https://*.freelancer.com/*",
    "https://*.freelancer.co.uk/*",
    "https://*.freelancer.in/*",
    "https://*.freelancer.com.au/*",
    "https://*.toptal.com/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Seerist Capture"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.upwork.com/*",
        "https://*.fiverr.com/*",
        "https://*.freelancer.com/*",
        "https://*.freelancer.co.uk/*",
        "https://*.freelancer.in/*",
        "https://*.freelancer.com.au/*",
        "https://*.toptal.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
